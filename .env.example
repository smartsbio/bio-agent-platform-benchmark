# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# MOST ARMS NEED NOTHING HERE. The hosted MCP servers (smarts.bio, Biomni) use
# OAuth: authorise each once in an interactive session and the CLI stores the
# token, keyed by server URL, for every later subprocess run.
#
#     claude mcp add --transport http smartsbio https://mcp.smarts.bio/mcp
#     claude        # then run /mcp and sign in
#
# `run_benchmark.py` probes every arm before it starts and refuses to run an arm
# whose server reports needs-auth, so you cannot silently record an
# authorisation failure as a platform limitation.

# --- smarts.bio arm -----------------------------------------------------
# OPTIONAL. Only for the API-key route (`--arms smartsbio-key` instead of
# `--arms smartsbio`). Prefer this for a published run: an API key documented
# here is reproducible by an outside reader, whereas an OAuth token in your
# keychain is not.
SMARTSBIO_API_KEY=
# Workspace holding the staged fixtures under tests/
SMARTSBIO_WORKSPACE_ID=

# --- Biomni arm ---------------------------------------------------------
# Biomni is benchmarked from its own source at a pinned commit, installed with
# the project's documented E1 environment. Everything lives under /absolute/path/to/biomni-e1
# and ./uninstall_biomni.sh removes all of it.
#
# Absolute paths only: this file is read as plain key=value, with no shell
# expansion, so ~ and $HOME are not resolved.
# Interpreter of the biomni_e1 environment.
BIOMNI_PYTHON=/absolute/path/to/biomni-e1/mamba/envs/biomni_e1/bin/python
# PATH for the server: the env's binaries (R, samtools, ...) then the CLI tools
# installed by setup.sh (PLINK, IQ-TREE, GCTA, ...).
BIOMNI_PATH=/absolute/path/to/biomni-e1/mamba/envs/biomni_e1/bin:/absolute/path/to/biomni-e1/tools/bin:/usr/bin:/bin:/usr/sbin:/sbin
# Data lake, downloaded on the server's first start (~11 GB).
BIOMNI_DATA_PATH=/absolute/path/to/biomni-e1/data
# Required. 35 of Biomni's 144 tools are LLM-mediated: they take a natural-language
# `prompt` and have Biomni's own model turn it into an API query. Without a key
# every one of them returns "Error querying LLM", which would zero the entire
# lookup category and measure this file rather than the platform. Biomni's
# default model is claude-sonnet-4-5 ($3/$15 per MTok); the whole benchmark costs
# a few dollars of it. Billed to whichever workspace the key belongs to.
ANTHROPIC_API_KEY=

# Set to 1 to serve only tools whose data sources are licensed for commercial
# use. Leave empty for Biomni's full capability.
BIOMNI_COMMERCIAL_MODE=

# --- Galaxy arm ---------------------------------------------------------
# Requires `uv` on PATH (brew install uv) for `uvx galaxy-mcp`.
# API key from usegalaxy.org -> User -> Preferences -> Manage API Key
GALAXY_URL=https://usegalaxy.org
GALAXY_API_KEY=

# --- baseline arm -------------------------------------------------------
# No credentials. Uses no MCP server and no built-in tools.
