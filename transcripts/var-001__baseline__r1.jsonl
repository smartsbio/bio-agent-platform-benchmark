l annotate them from knowledge, labeled as inference rather than tool output."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18935,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18935},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"45df2091-72cd-4df7-8b81-456e5a388a8d","uuid":"10d22a83-55e7-41cd-a634-61a2645bf1e3","timestamp":"2026-11-04T09:26:39.910Z","request_id":"req_011CgheZu43LgVYBzDJhGtwY"}
